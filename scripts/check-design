#!/usr/bin/env python3
"""Fail on raw hex colors or pixel font sizes in CSS outside design/: values belong in tokens.

``scripts/check-design`` checks the app's and the docs site's stylesheets, or the files it is given."""

from pathlib import Path
import re
import sys

ROOT = Path(__file__).resolve().parents[1]
RULES = {
    "a raw hex color": re.compile(r"#[0-9a-fA-F]{3,8}\b"),
    "a pixel font size": re.compile(r"font-size\s*:[^;}]*\d(?:px)\b"),
    "a pixel size in a font shorthand": re.compile(r"\bfont\s*:[^;}]*\dpx\b"),
}


def problems(path: Path) -> list[str]:
    """Find what breaks the rules in one stylesheet.

    :param path: The stylesheet.
    :return: One line per finding, with its file and line."""
    out = []
    for i, line in enumerate(path.read_text(encoding="utf-8").splitlines(), 1):
        for what, rule in RULES.items():
            out += [f"{path}:{i}: {what}: {m.group(0)}" for m in rule.finditer(line)]
    return out


def main() -> None:
    """Check the files and fail when anything is found."""
    files = [Path(a) for a in sys.argv[1:]] or [
        *sorted((ROOT / "web" / "src" / "styles").glob("*.css")),
        ROOT / "web" / "docs" / "docs.css",
    ]
    found = [line for f in files for line in problems(f)]
    if found:
        sys.exit("\n".join([*found, "Values belong in design/tokens.json."]))


if __name__ == "__main__":
    main()
